---
import { url } from '../lib/url';
---

<section class="relative overflow-hidden">
  <div class="mx-auto max-w-container w-full px-page pt-6 pb-8 md:pt-10 md:pb-12">
    <div class="flex flex-col md:flex-row gap-8 items-center">
      <!-- Photo -->
      <div class="w-full md:w-[60%] rise">
        <div class="overflow-hidden">
          <img
            src={url("/campus.png")}
            alt="Ilustração do campus da EACH-USP"
            class="w-full aspect-[4/5] sm:aspect-[3/2] lg:aspect-auto lg:h-[700px] object-cover object-center"
          />
        </div>
      </div>

      <!-- Title -->
      <div class="w-full md:w-[40%] rise rise-d2">
        <h1 class="font-display text-display-post font-black leading-[0.95] tracking-tight text-ink uppercase text-left">
          Programa de Pós-Graduação em Sistemas de Informação
        </h1>
        <p class="mt-6 text-body-lg text-ink-3 leading-relaxed">
          Escola de Artes, Ciências e Humanidades<br/>
          Universidade de São Paulo
        </p>
        <p class="mt-4 text-body text-ink-4 leading-relaxed italic">
          Pesquisa de ponta em computação para resolver problemas reais.
        </p>
      </div>
    </div>
  </div>
</section>
