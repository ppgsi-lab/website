---
import PostCard from './PostCard.astro';
import { getCollection } from 'astro:content';

const posts = (await getCollection('posts'))
  .sort((a, b) => b.data.date.getTime() - a.data.date.getTime())
  .slice(0, 3);
import { url } from '../lib/url';
---

{posts.length > 0 && (
  <section class="px-page py-section-compact md:py-section-compact-md">
    <div class="mx-auto max-w-container">
      <h2 class="font-display text-display-hero font-bold tracking-tight leading-display-hero text-ink mb-8 md:mb-12">
        Últimas publicações
      </h2>

      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-4">
        {posts.map((post) => (
          <PostCard
            title={post.data.title}
            authors={post.data.authors}
            date={post.data.date}
            tags={post.data.tags}
            summary={post.data.summary}
            slug={post.id}
            cover={post.data.cover}
          />
        ))}
      </div>

      <a href={url("/posts")} class="mt-8 inline-block text-body-xs text-ink-4 hover:text-ink transition-colors">
        Ver todas as publicações →
      </a>
    </div>
  </section>
)}
