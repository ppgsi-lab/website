---
import { getResearchLineSummaries, getUI } from '../lib/data';

const lines = getResearchLineSummaries();
const ui = getUI();
import { url } from '../lib/url';
---

<section class="px-page pt-12 pb-12 md:pt-16 md:pb-16">
  <div class="mx-auto max-w-container">
    <h2 class="font-display text-display-hero font-bold tracking-tight leading-display-hero text-ink mb-12 md:mb-16">
      {ui.research.areasTitle}
    </h2>

    <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
      {lines.map((line) => (
        <a href={url(line.href)} class:list={[
          'relative border-2 block group/line transition-colors duration-200',
          line.color === 'teal' ? 'border-teal hover:bg-teal-50' : 'border-yellow hover:bg-yellow-light',
        ]}>
          <h3 class:list={[
            'absolute -top-[2px] -left-[2px] font-display text-lg md:text-display-section font-bold tracking-tight leading-tight px-4 py-2 -translate-y-1/2',
            line.color === 'teal' ? 'bg-teal text-white' : 'bg-yellow text-ink',
          ]}>
            {line.name}
          </h3>

          <div class="pt-12 pb-8 px-6 sm:px-8 md:px-10 md:pb-10">
            <div class="space-y-4">
              {line.areas.map((area) => (
                <div>
                  <span class="text-body font-bold text-ink">{area.name}</span>
                  <p class="text-body-sm text-ink-3 leading-relaxed mt-1">{area.description}</p>
                </div>
              ))}
            </div>

            <span class:list={[
              'mt-6 inline-flex text-body-sm font-bold transition-colors',
              line.color === 'teal' ? 'text-teal group-hover/line:text-teal-dark' : 'text-ink-3 group-hover/line:text-ink',
            ]}>
              {ui.research.viewDetails} →
            </span>
          </div>
        </a>
      ))}
    </div>
  </div>
</section>
