---
import { url } from '../../lib/url';
import { formatDate, localeOf } from '../../lib/i18n';

export interface Entry {
  date: Date;
  title: string;
  href: string;
  /** Linha abaixo do título: autores de um texto ou o resumo de um aviso. */
  meta: string;
}

interface Props {
  items: Entry[];
}

const { items } = Astro.props;
const locale = localeOf(Astro.url);
---

<ul>
  {items.map((item) => <li><time datetime={item.date.toISOString().slice(0, 10)}>{formatDate(item.date, locale)}</time><a href={url(item.href, locale)}>{item.title}</a><span>{item.meta}</span></li>)}
</ul>

<style>
  ul { list-style: none; margin: 0; padding: 0; max-width: none; font-family: var(--font-sans); }
  li { display: grid; grid-template-columns: 180px 1fr; column-gap: 24px; row-gap: 4px; padding: 16px 0; border-bottom: var(--rule-hairline) var(--hairline); }
  li + li { margin-top: 0; }
  time { grid-row: span 2; font-size: 14px; color: var(--muted); padding-top: 4px; }
  a { font-family: var(--font-serif); font-optical-sizing: auto; font-size: 21px; line-height: 1.2; color: var(--ink); text-decoration: none; }
  a:hover { color: var(--teal); }
  span { font-size: 14px; color: var(--muted); }

  @media (max-width: 699px) {
    li { grid-template-columns: 1fr; }
    time { grid-row: auto; padding-top: 0; }
  }
</style>
