---
interface Props {
  steps: { title: string; text: string }[];
}

const { steps } = Astro.props;
---

<ol class="steps not-doc">
  {steps.map((step, i) => <li><b>{i + 1}</b><strong>{step.title}</strong><span>{step.text}</span></li>)}
</ol>

<style>
  .steps { list-style: none; margin: 24px 0 32px; padding: 0; display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 32px; }
  li { min-width: 0; padding-top: 14px; border-top: 2px solid var(--ink); }
  b { display: block; font-family: var(--font-serif); font-size: 44px; line-height: 1; color: var(--teal); margin-bottom: 10px; font-weight: 400; }
  strong { display: block; font-size: 17px; font-weight: 700; margin-bottom: 4px; }
  span { font-size: 14px; color: var(--muted); display: block; }

  @media (max-width: 1099px) {
    .steps { gap: 28px 24px; }
    b { font-size: 36px; }
  }

  @media (max-width: 699px) {
    .steps { grid-template-columns: 1fr; gap: 0; }
    li { display: grid; grid-template-columns: 40px 1fr; column-gap: 12px; padding: 14px 0; border-top: var(--rule-hairline) var(--hairline); }
    li:first-child { border-top: 2px solid var(--ink); }
    b { font-size: 30px; grid-row: 1 / 3; margin: 0; line-height: 1.1; }
  }
</style>
