---
import type { NavChild, NavGroup, NavItem } from '../../types';

interface Props {
  nav: NavItem[];
}

const { nav } = Astro.props;

function isGroup(item: NavChild | NavGroup): item is NavGroup {
  return 'group' in item;
}

function hasGroups(children: (NavChild | NavGroup)[]): boolean {
  return children.some(c => isGroup(c));
}
---

<div class="hidden lg:flex items-center gap-1">
  {nav.map((item) => (
    <div class="relative group/nav">
      {item.href ? (
        <a href={item.href}
           class="hover-item py-2 px-3 text-nav font-bold text-ink uppercase">
          {item.label}
        </a>
      ) : (
        <button class="hover-item py-2 px-3 text-nav font-bold text-ink uppercase flex items-center gap-1.5">
          {item.label}
          <svg class="w-3.5 h-3.5 opacity-40 transition-transform duration-200 group-hover/nav:rotate-180" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M19.5 8.25l-7.5 7.5-7.5-7.5" />
          </svg>
        </button>
      )}

      {item.children && !hasGroups(item.children) && (
        <div class="absolute top-full left-0 pt-2 opacity-0 invisible translate-y-1
                    group-hover/nav:opacity-100 group-hover/nav:visible group-hover/nav:translate-y-0
                    transition-all duration-200">
          <div class="bg-bone border border-rule shadow-lg py-2 min-w-[280px]">
            {(item.children as NavChild[]).map((child) => (
              <a href={child.href}
                 class="hover-item block px-4 py-2.5 text-body font-semibold text-ink-3 uppercase">
                {child.label}
              </a>
            ))}
          </div>
        </div>
      )}

      {item.children && hasGroups(item.children) && (
        <div class="absolute top-full left-0 pt-2 opacity-0 invisible translate-y-1
                    group-hover/nav:opacity-100 group-hover/nav:visible group-hover/nav:translate-y-0
                    transition-all duration-200">
          <div class="bg-bone border border-rule shadow-lg py-4 min-w-[560px]">
            <div class="grid grid-cols-2 gap-0">
              {(item.children as (NavChild | NavGroup)[]).filter(c => isGroup(c)).map((child) => (
                <div class="px-5">
                  <p class="eyebrow text-ink-4 mb-3 px-2">
                    {(child as NavGroup).group}
                  </p>
                  {(child as NavGroup).items.map((sub) => (
                    <a href={sub.href}
                       class="hover-item block px-2 py-2 text-body font-semibold text-ink-3 uppercase">
                      {sub.label}
                    </a>
                  ))}
                </div>
              ))}
            </div>
            {(item.children as (NavChild | NavGroup)[]).filter(c => !isGroup(c)).length > 0 && (
              <div class="border-t border-rule/50 mt-3 pt-3 mx-5">
                {(item.children as (NavChild | NavGroup)[]).filter(c => !isGroup(c)).map((child) => (
                  <a href={(child as NavChild).href}
                     class="hover-item block px-2 py-2 text-body font-semibold text-ink-3 uppercase">
                    {(child as NavChild).label}
                  </a>
                ))}
              </div>
            )}
          </div>
        </div>
      )}
    </div>
  ))}
</div>
