---
import type { UIStrings } from '../../types';

interface Props {
  ui: UIStrings;
}

const { ui } = Astro.props;
import { url } from '../../lib/url';
---

<footer class="bg-teal text-white mt-16">
  <div class="mx-auto max-w-container px-page py-section">
    <div class="grid grid-cols-1 md:grid-cols-12 gap-8 md:gap-12 lg:gap-16">
      <div class="md:col-span-4">
        <p class="font-display text-display-card font-bold leading-tight tracking-tight">
          {ui.footer.programName}
        </p>
        <p class="text-body-xs text-on-primary-subtle mt-6 leading-relaxed max-w-sm">
          {ui.footer.institution}<br/>
          {ui.footer.university}<br/>
          {ui.footer.address}<br/>
          {ui.footer.zip}
        </p>
      </div>

      <div class="md:col-span-2">
        <p class="eyebrow text-on-primary-faint mb-4">{ui.footer.sectionProgram}</p>
        <ul class="space-y-2.5">
          <li><a href={url("/about")} class="text-body-sm text-on-primary-muted hover:text-white transition-colors">{ui.footer.presentation}</a></li>
          <li><a href={url("/about/research")} class="text-body-sm text-on-primary-muted hover:text-white transition-colors">{ui.footer.research}</a></li>
          <li><a href={url("/courses")} class="text-body-sm text-on-primary-muted hover:text-white transition-colors">{ui.footer.courses}</a></li>
          <li><a href={url("/about/regulations")} class="text-body-sm text-on-primary-muted hover:text-white transition-colors">{ui.footer.regulations}</a></li>
          <li><a href={url("/posts")} class="text-body-sm text-on-primary-muted hover:text-white transition-colors">{ui.footer.posts}</a></li>
        </ul>
      </div>

      <div class="md:col-span-2">
        <p class="eyebrow text-on-primary-faint mb-4">{ui.footer.sectionAcademic}</p>
        <ul class="space-y-2.5">
          <li><a href={url("/admission")} class="text-body-sm text-on-primary-muted hover:text-white transition-colors">{ui.footer.admission}</a></li>
          <li><a href={url("/admission/open")} class="text-body-sm text-on-primary-muted hover:text-white transition-colors">{ui.footer.openCalls}</a></li>
          <li><a href={url("/academic/forms")} class="text-body-sm text-on-primary-muted hover:text-white transition-colors">{ui.footer.forms}</a></li>
          <li><a href={url("/academic/funding")} class="text-body-sm text-on-primary-muted hover:text-white transition-colors">{ui.footer.funding}</a></li>
          <li><a href={url("/faq")} class="text-body-sm text-on-primary-muted hover:text-white transition-colors">{ui.footer.faq}</a></li>
        </ul>
      </div>

      <div class="md:col-span-2">
        <p class="eyebrow text-on-primary-faint mb-4">{ui.footer.sectionPeople}</p>
        <ul class="space-y-2.5">
          <li><a href={url("/people")} class="text-body-sm text-on-primary-muted hover:text-white transition-colors">{ui.footer.advisors}</a></li>
          <li><a href={url("/people/students")} class="text-body-sm text-on-primary-muted hover:text-white transition-colors">{ui.footer.students}</a></li>
          <li><a href={url("/people/ccp")} class="text-body-sm text-on-primary-muted hover:text-white transition-colors">{ui.footer.ccp}</a></li>
        </ul>
      </div>

      <div class="md:col-span-2">
        <p class="eyebrow text-on-primary-faint mb-4">{ui.footer.sectionLinks}</p>
        <ul class="space-y-2.5">
          <li><a href="https://each.usp.br" target="_blank" rel="noopener" class="text-body-sm text-on-primary-muted hover:text-white transition-colors">{ui.footer.each} ↗</a></li>
          <li><a href="https://www.usp.br" target="_blank" rel="noopener" class="text-body-sm text-on-primary-muted hover:text-white transition-colors">{ui.footer.usp} ↗</a></li>
          <li><a href="https://www.gov.br/capes" target="_blank" rel="noopener" class="text-body-sm text-on-primary-muted hover:text-white transition-colors">{ui.footer.capes} ↗</a></li>
        </ul>
      </div>
    </div>

    <div class="mt-12 md:mt-16 lg:mt-20 pt-6 border-t border-on-primary-ghost">
      <p class="text-tag text-on-primary-dim">
        &copy; {new Date().getFullYear()} PPgSI — EACH/USP
      </p>
    </div>
  </div>
</footer>
