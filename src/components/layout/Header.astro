---
import type { NavItem } from '../../types';
import DesktopNav from './DesktopNav.astro';
import MobileMenu from './MobileMenu.astro';

interface Props {
  nav: NavItem[];
}

const { nav } = Astro.props;
import { url } from '../../lib/url';
---

<header class="fixed top-0 inset-x-0 z-50">
  <div class="bg-bone border-b border-rule/50">
    <nav class="mx-auto max-w-container px-8 flex items-center justify-between h-16">
      <!-- PPgSI logo -->
      <a href={url("/")} class="hidden lg:block shrink-0">
        <img src={url("/ppgsi.svg")} alt="PPgSI" class="h-16 pt-1" />
      </a>

      <DesktopNav nav={nav} />

      <!-- EACH + USP logos -->
      <div class="hidden lg:flex items-center gap-6 shrink-0">
        <a href="https://each.usp.br" target="_blank" rel="noopener">
          <img src={url("/logoeach.png")} alt="EACH-USP" class="h-12" />
        </a>
        <a href="https://www.usp.br" target="_blank" rel="noopener">
          <img src={url("/logo_usp.png")} alt="USP" class="h-10" />
        </a>
      </div>

      <!-- Mobile toggle -->
      <button id="mobile-toggle" class="lg:hidden p-1 text-ink-3" aria-label="Menu">
        <svg class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
          <path stroke-linecap="round" stroke-linejoin="round" d="M3.75 9h16.5m-16.5 6.75h16.5" />
        </svg>
      </button>
    </nav>
  </div>

  <MobileMenu nav={nav} />
</header>
