---
import type { NavChild, NavGroup, NavItem } from '../../types';

interface Props {
  nav: NavItem[];
}

const { nav } = Astro.props;

function isGroup(item: NavChild | NavGroup): item is NavGroup {
  return 'group' in item;
}
import { url } from '../../lib/url';
---

<div id="mobile-menu" class="hidden lg:hidden bg-bone border-b border-rule px-page pb-6 pt-2 max-h-[85dvh] overflow-y-auto">
  {nav.map((item) => (
    <div class="border-b border-rule/50 last:border-0">
      {item.href ? (
        <a href={url(item.href)} class="hover-item block py-3 px-3 -mx-3 text-body-lg font-bold text-ink uppercase">
          {item.label}
        </a>
      ) : (
        <div>
          <button class="hover-item mobile-accordion-toggle w-full flex items-center justify-between py-3 px-3 -mx-3 text-body-lg font-bold text-ink uppercase">
            {item.label}
            <svg class="w-4 h-4 opacity-40 transition-transform duration-200" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M19.5 8.25l-7.5 7.5-7.5-7.5" />
            </svg>
          </button>
          <div class="mobile-accordion-content hidden pb-3 pl-4">
            {item.children && (item.children as (NavChild | NavGroup)[]).map((child) => (
              isGroup(child) ? (
                <div class="mb-3">
                  <p class="eyebrow text-ink-4 mb-2 mt-2">
                    {child.group}
                  </p>
                  {child.items.map((sub) => (
                    <a href={url(sub.href)} class="hover-item block py-2 px-2 -mx-2 text-body-sm font-semibold text-ink-3 uppercase">
                      {sub.label}
                    </a>
                  ))}
                </div>
              ) : (
                <a href={url((child as NavChild).href)} class="hover-item block py-2 px-2 -mx-2 text-body-sm font-semibold text-ink-3 uppercase">
                  {(child as NavChild).label}
                </a>
              )
            ))}
          </div>
        </div>
      )}
    </div>
  ))}

  <div class="flex flex-wrap items-center justify-center gap-6 pt-6">
    <a href="https://each.usp.br" target="_blank" rel="noopener">
      <img src={url("/logoeach.png")} alt="EACH-USP" class="h-10 w-auto" />
    </a>
    <a href="https://www.usp.br" target="_blank" rel="noopener">
      <img src={url("/logo_usp.png")} alt="USP" class="h-8 w-auto" />
    </a>
  </div>
</div>
