---
import type { NavChild, NavGroup, NavItem } from '../../types';

interface Props {
  nav: NavItem[];
}

const { nav } = Astro.props;

function isGroup(item: NavChild | NavGroup): item is NavGroup {
  return 'group' in item;
}
---

<div id="mobile-menu" class="hidden lg:hidden bg-bone border-b border-rule px-8 pb-6 pt-2 max-h-[80vh] overflow-y-auto">
  {nav.map((item) => (
    <div class="border-b border-rule/50 last:border-0">
      {item.href ? (
        <a href={item.href} class="block py-3 text-body-sm text-ink-3 hover:text-ink">
          {item.label}
        </a>
      ) : (
        <div>
          <button class="mobile-accordion-toggle w-full flex items-center justify-between py-3 text-body-sm text-ink-3 hover:text-ink">
            {item.label}
            <svg class="w-4 h-4 opacity-40 transition-transform duration-200" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M19.5 8.25l-7.5 7.5-7.5-7.5" />
            </svg>
          </button>
          <div class="mobile-accordion-content hidden pb-3 pl-4">
            {item.children && (item.children as (NavChild | NavGroup)[]).map((child) => (
              isGroup(child) ? (
                <div class="mb-3">
                  <p class="eyebrow text-ink-4 mb-2 mt-2">
                    {child.group}
                  </p>
                  {child.items.map((sub) => (
                    <a href={sub.href} class="block py-2 text-body-xs text-ink-3 hover:text-ink">
                      {sub.label}
                    </a>
                  ))}
                </div>
              ) : (
                <a href={(child as NavChild).href} class="block py-2 text-body-xs text-ink-3 hover:text-ink">
                  {(child as NavChild).label}
                </a>
              )
            ))}
          </div>
        </div>
      )}
    </div>
  ))}

  <div class="flex items-center gap-4 pt-4">
    <a href="/">
      <img src="/ppgsi_logo.svg" alt="PPgSI" class="h-10" />
    </a>
    <a href="https://each.usp.br" target="_blank" rel="noopener">
      <img src="/logoeach.png" alt="EACH-USP" class="h-10" />
    </a>
    <a href="https://www.usp.br" target="_blank" rel="noopener">
      <img src="/logo_usp.png" alt="USP" class="h-8" />
    </a>
  </div>
</div>
