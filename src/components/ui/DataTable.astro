---
interface Column {
  key: string;
  label: string;
  class?: string;
}

interface Props {
  columns: Column[];
  rows: Record<string, any>[];
  class?: string;
}

const { columns, rows, class: className } = Astro.props;
---

<div class:list={['overflow-x-auto', className]}>
  <table class="w-full text-left text-body-sm">
    <thead>
      <tr class="border-b-2 border-ink">
        {columns.map((col) => (
          <th class:list={['py-3 pr-4 font-bold text-ink', col.class]}>
            {col.label}
          </th>
        ))}
      </tr>
    </thead>
    <tbody>
      {rows.map((row) => (
        <tr class="border-b border-rule">
          {columns.map((col, i) => (
            <td class:list={[
              'py-3 pr-4',
              i === 0 ? 'text-ink font-medium' : 'text-ink-2',
              col.class,
            ]}>
              {row[col.key] || <span class="text-ink-4">&mdash;</span>}
            </td>
          ))}
        </tr>
      ))}
    </tbody>
  </table>
</div>
