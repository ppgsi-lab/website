---
interface Props {
  eyebrow?: string;
  title: string;
  description?: string;
}

const { eyebrow, title, description } = Astro.props;
---

{eyebrow && (
  <p class="eyebrow text-teal mb-3">{eyebrow}</p>
)}
<h1 class="font-display text-display-page font-bold tracking-tight text-ink mb-4">
  {title}
</h1>
{description && (
  <p class="text-ink-3 max-w-2xl mb-8">{description}</p>
)}
