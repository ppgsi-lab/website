---
interface NavLink {
  label: string;
  href: string;
}

interface Props {
  prev?: NavLink;
  next?: NavLink;
}

const { prev, next } = Astro.props;
import { url } from '../../lib/url';
---

<nav class="mt-16 pt-8 border-t border-rule flex flex-wrap gap-4">
  {prev && (
    <a href={url(prev.href)} class="hover-item px-4 py-2 text-sm font-medium text-ink transition-colors">
      &larr; {prev.label}
    </a>
  )}
  {next && (
    <a href={url(next.href)} class="hover-item px-4 py-2 text-sm font-medium text-ink transition-colors">
      {next.label} &rarr;
    </a>
  )}
</nav>
