---
interface Props {
  class?: string;
  narrow?: boolean;
  width?: 'full' | 'content' | 'prose' | 'narrative';
}

const { class: className, narrow, width } = Astro.props;

const widthMap: Record<string, string> = {
  full: 'max-w-container',
  content: 'max-w-content',
  prose: 'max-w-prose',
  narrative: 'max-w-narrative',
};

const maxWidth = width
  ? widthMap[width]
  : narrow
    ? 'max-w-narrative'
    : 'max-w-container';
---

<section class:list={['mx-auto px-8 py-section md:py-section-md', maxWidth, className]}>
  <slot />
</section>
