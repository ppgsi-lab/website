---
import '../styles/global.css';
import { ClientRouter } from 'astro:transitions';
import Masthead from '../components/ds/Masthead.astro';
import Footer from '../components/ds/Footer.astro';
import { getNavigation, getUI } from '../lib/data';
import { languageTag, localeOf, locales } from '../lib/i18n';
import { asset, route, url } from '../lib/url';

interface Props {
  title: string;
  description?: string;
  /** Seção do menu principal marcada como atual. */
  section?: string;
  /** Página sem equivalente nos outros idiomas: o seletor leva para esta rota e não há links hreflang. */
  alternate?: string;
}

const { title, description, section, alternate } = Astro.props;
const locale = localeOf(Astro.url);
const nav = getNavigation(locale);
const ui = getUI(locale);
const path = route(Astro.url);
// Marca d'água, ligada enquanto site.watermark (ui.yaml) tiver texto: o texto vira a máscara que global.css pinta atrás do conteúdo.
const watermark = ui.site.watermark && `<svg xmlns="http://www.w3.org/2000/svg" width="360" height="200" font-family="Helvetica, Arial, sans-serif" font-size="32" font-weight="700"><text x="180" y="100" transform="rotate(-25 180 100)" text-anchor="middle" dominant-baseline="middle">${ui.site.watermark}</text></svg>`;
---

<!doctype html>
<html lang={languageTag[locale]}>
  <head>
    <meta charset="utf-8" />
    <link rel="icon" type="image/svg+xml" href={asset('/favicon.svg')} />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description ?? ui.site.description} />
    <meta name="generator" content={Astro.generator} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Newsreader:ital,opsz,wght@0,6..72,200..800;1,6..72,200..800&family=Hanken+Grotesk:ital,wght@0,300..800;1,300..800&display=swap" />
    {!alternate && locales.map((other) => <link rel="alternate" hreflang={languageTag[other]} href={new URL(url(path, other), Astro.site)} />)}
    <title>{title} — {ui.site.title}</title>
    <ClientRouter />
  </head>
  <body class:list={{ watermark }} style={watermark ? `--watermark: url("data:image/svg+xml,${encodeURIComponent(watermark)}")` : undefined}>
    <Masthead nav={nav.main} current={section} alternate={alternate} />
    <main><slot /></main>
    <Footer columns={nav.footer} />
  </body>
</html>
