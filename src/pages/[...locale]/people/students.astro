---
import PageLayout from '../../../layouts/PageLayout.astro';
import Template from '../../../components/Template.astro';
import DocLayout from '../../../components/ds/DocLayout.astro';
import SideList from '../../../components/ds/SideList.astro';
import Table from '../../../components/ds/Table.astro';
import { getStudents, getUI } from '../../../lib/data';
import { fill, localeOf, localeParams } from '../../../lib/i18n';
import type { Student } from '../../../types';

export const getStaticPaths = localeParams;

const locale = localeOf(Astro.url);
const ui = getUI(locale);
const t = ui.people;
const { doctorate, masters } = getStudents(locale);
const columns = [ui.table.name, ui.table.advisor, ui.table.entry, ui.table.email];
const rows = (students: Student[]) =>
  students.map((student) => [student.lattesUrl ? { label: student.name, href: student.lattesUrl } : student.name, student.advisor, student.entrySemester, student.email]);
const toc = [
  { label: t.doctorate, href: '#doutorado' },
  { label: t.masters, href: '#mestrado' },
  { label: t.lists, href: '#listas' },
];
---

<PageLayout title={t.studentsTitle} sub={t.studentsText}>
  <DocLayout>
    <SideList slot="side" toc label={ui.page.toc} items={toc} />
    <h2 id="doutorado">{t.doctorate}</h2>
    <p>{fill(t.doctorateCount, { count: doctorate.length })}</p>
    <Table fluid columns={columns} rows={rows(doctorate)} />
    <h2 id="mestrado">{t.masters}</h2>
    <p>{fill(t.mastersCount, { count: masters.length })}</p>
    <Table fluid columns={columns} rows={rows(masters)} />
    <h2 id="listas">{t.lists}</h2>
    <p><Template text={t.listsText}><strong slot="official">alunosppgsi-each@listas.usp.br</strong><strong slot="informal">ppgsi-each@googlegroups.com</strong></Template></p>
  </DocLayout>
</PageLayout>
