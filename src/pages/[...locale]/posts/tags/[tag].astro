---
import PageLayout from '../../../../layouts/PageLayout.astro';
import DocLayout from '../../../../components/ds/DocLayout.astro';
import EntryList from '../../../../components/ds/EntryList.astro';
import SideList from '../../../../components/ds/SideList.astro';
import { getUI } from '../../../../lib/data';
import { byDateDesc, getLocalized, tagLabel, type LocalizedEntry } from '../../../../lib/content';
import { fill, localeOf, localeParam, locales } from '../../../../lib/i18n';

export async function getStaticPaths() {
  const paths = [];
  for (const locale of locales) {
    const posts = byDateDesc(await getLocalized('posts', locale));
    const tags = [...new Set(posts.flatMap(({ entry }) => entry.data.tags))].sort();
    for (const tag of tags) {
      paths.push({ params: { locale: localeParam(locale), tag }, props: { tag, tags, posts: posts.filter(({ entry }) => entry.data.tags.includes(tag)) } });
    }
  }
  return paths;
}

interface Props {
  tag: string;
  tags: string[];
  posts: LocalizedEntry<'posts'>[];
}

const { tag, tags, posts } = Astro.props;
const ui = getUI(localeOf(Astro.url));
const label = tagLabel(tag);
---

<PageLayout title={fill(ui.posts.tagTitle, { tag: label })} sub={fill(ui.posts.tagSub, { tag: label })} parent="/posts" alternate="/posts">
  <DocLayout>
    <SideList slot="side" label={ui.posts.topics} items={tags.map((other) => ({ label: tagLabel(other), href: `/posts/tags/${other}` }))} />
    <EntryList items={posts.map(({ slug, entry }) => ({ date: entry.data.date, title: entry.data.title, href: `/posts/${slug}`, meta: entry.data.authors.map((author) => author.name).join(', ') }))} />
  </DocLayout>
</PageLayout>
