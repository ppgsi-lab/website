      <a href="/about/areas" class="hover-item px-4 py-2 text-sm font-medium text-ink transition-colors">Áreas de Aplicação &rarr;</a>
      <a href="/courses" class="hover-item px-4 py-2 text-sm font-medium text-ink transition-colors">Disciplinas &rarr;</a>
      <a href="/about/regulations" class="hover-item px-4 py-2 text-sm font-medium text-ink transition-colors">Regulamentos &rarr;</a>
      <a href="/about/production" class="hover-item px-4 py-2 text-sm font-medium text-ink transition-colors">Produção &rarr;</a>
    </nav>
  </section>
</Layout>
