---
import Layout from '../../../layouts/Layout.astro';

const lines = [
  {
    name: 'Gestão e Desenvolvimento de Sistemas',
    href: '/about/research/gestao-e-desenvolvimento',
    color: 'teal',
    description: 'Estudo, proposta, aplicação e avaliação de metodologias e técnicas da Computação no contexto de desenvolvimento de Sistemas de Informação de valor estratégico para diversas áreas de aplicação.',
    areas: ['Banco de Dados', 'Engenharia de Software', 'Gestão de Tecnologia da Informação', 'Interação Humano-Computador', 'Redes de Computadores'],
  },
  {
    name: 'Inteligência de Sistemas',
    href: '/about/research/inteligencia-de-sistemas',
    color: 'yellow',
    description: 'Estudo, proposta, aplicação e avaliação de metodologias e técnicas da Computação no desenvolvimento de soluções algorítmicas avançadas e inovadoras para problemas de diversas áreas de aplicação.',
    areas: ['Inteligência Artificial', 'Processamento Gráfico', 'Reconhecimento de Padrões', 'Computação Sonora e Musical'],
  },
];

const applicationAreas = [
  'Ambientes corporativos / Processos de negócio',
  'Bioinformática',
  'Biometria',
  'Dispositivos móveis',
  'Educação / Educação a distância',
  'Governo eletrônico',
  'Internet / Redes sociais',
  'Jogos / Jogos sérios',
  'Linguística / Língua natural',
  'Quimioinformática',
  'Robótica',
  'Saúde',
  'Recuperação de informação sonora/musical',
  'Realidade virtual/expandida/aumentada',
  'Personalização e imersão audiovisual',
  'Música digital',
];
---

<Layout title="Pesquisa" description="Linhas de pesquisa, áreas de pesquisa e áreas de aplicação do PPgSI - EACH/USP">
  <section class="mx-auto max-w-narrative px-8 py-section md:py-section-md">
    <h1 class="font-display text-display-page font-bold tracking-tight text-ink mb-12">
      Pesquisa
    </h1>

    <div class="space-y-6">
      <p class="text-body-lg text-ink-2 leading-relaxed">
        <strong>Área Básica de Conhecimento:</strong> Ciência da Computação
      </p>
      <p class="text-body-lg text-ink-2 leading-relaxed">
        <strong>Área de Concentração:</strong> Metodologia e Técnicas da Computação
      </p>
      <p class="text-body-lg text-ink-2 leading-relaxed">
        A pesquisa no PPgSI é organizada em duas linhas de pesquisa, cada uma com áreas de pesquisa específicas. Essas linhas se cruzam com diversas áreas de aplicação, formando eixos de pesquisa ortogonais que refletem a natureza inerentemente aplicada e interdisciplinar de Sistemas de Informação.
      </p>
    </div>

    <!-- Research lines -->
    <div class="grid grid-cols-1 md:grid-cols-2 gap-6 mt-16">
      {lines.map((line) => (
        <a href={line.href} class:list={[
          'relative border-2 block group/line transition-colors duration-200',
          line.color === 'teal' ? 'border-teal hover:bg-teal-50' : 'border-yellow hover:bg-yellow-light',
        ]}>
          <h2 class:list={[
            'absolute -top-[2px] -left-[2px] font-display text-lg md:text-xl font-bold tracking-tight leading-tight px-4 py-2 -translate-y-1/2',
            line.color === 'teal' ? 'bg-teal text-white' : 'bg-yellow text-ink',
          ]}>
            {line.name}
          </h2>

          <div class="pt-12 pb-8 px-8 md:px-10 md:pb-10">
            <p class="text-body-lg text-ink-2 leading-relaxed mb-6">
              {line.description}
            </p>

            <p class="eyebrow text-ink-4 mb-3">
              Áreas de pesquisa
            </p>
            <ul class="space-y-1">
              {line.areas.map((area) => (
                <li class="text-body text-ink-3">{area}</li>
              ))}
            </ul>

            <span class:list={[
              'mt-6 inline-flex text-body-sm font-bold transition-colors',
              line.color === 'teal' ? 'text-teal group-hover/line:text-teal-dark' : 'text-ink-3 group-hover/line:text-ink',
            ]}>
              Ver detalhes →
            </span>
          </div>
        </a>
      ))}
    </div>

    <!-- Application areas -->
    <div class="mt-20">
      <h2 class="font-display text-display-section md:text-3xl font-bold tracking-tight text-ink mb-8">
        Áreas de Aplicação
      </h2>
      <p class="text-body-lg text-ink-2 leading-relaxed max-w-3xl mb-8">
        A pesquisa desenvolvida no PPgSI baseia-se em eixos de pesquisa ortogonais, resultantes da intersecção entre as linhas de pesquisa e diversas áreas de aplicação, refletindo a natureza inerentemente aplicada e interdisciplinar de Sistemas de Informação.
      </p>
      <div class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-3 gap-x-8 gap-y-3 border-t border-rule pt-8">
        {applicationAreas.map((area) => (
          <span class="text-body text-ink-2 py-1">{area}</span>
        ))}
      </div>
    </div>

    <!-- Navigation links -->
    <nav class="mt-16 pt-8 border-t border-rule flex flex-wrap gap-4">
      <a href="/about" class="hover-item px-4 py-2 text-sm font-medium text-ink transition-colors">&larr; Apresentação Geral</a>
      <a href="/courses" class="hover-item px-4 py-2 text-sm font-medium text-ink transition-colors">Disciplinas &rarr;</a>
    </nav>
  </section>
</Layout>
