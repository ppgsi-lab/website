---
import Layout from '../../layouts/Layout.astro';
import PageHeader from '../../components/ui/PageHeader.astro';
import DataTable from '../../components/ui/DataTable.astro';
import {
  getCourses,
  getRequiredCourses,
  getResearchLineSummaries,
  getUI,
} from '../../lib/data';

const ui = getUI();
const t = ui.courses;
const allCourses = getCourses();
const required = getRequiredCourses();
const researchLines = getResearchLineSummaries();

function slugFromHref(href: string): string {
  return href.replace(/^\/about\/research\//, '');
}

const electivesByLine = researchLines.map((line) => {
  const slug = slugFromHref(line.href);
  const items = allCourses.filter(
    (c) => c.type === 'elective' && (c.researchLine === slug || c.researchLine === 'both'),
  );
  return { line, items };
});

const electivesCrossLine = allCourses.filter(
  (c) => c.type === 'elective' && !c.researchLine,
);

const columns = [
  { key: 'code', label: t.colCode, class: 'w-24 md:w-32' },
  { key: 'name', label: t.colCourse },
  { key: 'credits', label: t.colCredits, class: 'w-20 text-right' },
  { key: 'hours', label: t.colHours, class: 'hidden md:table-cell w-32' },
];

function toRows(courses: typeof allCourses) {
  return courses.map((c) => ({
    code: c.code,
    name: c.name,
    credits: c.credits,
    hours: c.weeklyHours,
  }));
}
---

<Layout title={t.title} description={t.description}>
  <section class="mx-auto max-w-narrative px-page py-section md:py-section-md">
    <PageHeader title={t.title} description={t.description} />

    <h2 class="font-display text-display-section font-bold text-ink mt-12 mb-4">
      {t.required}
    </h2>
    <DataTable columns={columns} rows={toRows(required)} />

    {electivesByLine.map(({ line, items }) => (
      items.length > 0 && (
        <div class="mt-12">
          <div class:list={[
            'inline-block font-display text-lg md:text-display-section font-bold tracking-tight leading-tight px-4 py-2 mb-4',
            line.color === 'teal' ? 'bg-teal text-white' : 'bg-yellow text-ink',
          ]}>
            {t.electivesPrefix} — {line.name}
          </div>
          <DataTable columns={columns} rows={toRows(items)} />
        </div>
      )
    ))}

    {electivesCrossLine.length > 0 && (
      <div class="mt-12">
        <h2 class="font-display text-display-section font-bold text-ink mb-4">
          {t.electivesPrefix}
        </h2>
        <DataTable columns={columns} rows={toRows(electivesCrossLine)} />
      </div>
    )}
  </section>
</Layout>
