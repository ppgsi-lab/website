---
import Layout from '../../layouts/Layout.astro';
import Section from '../../components/ui/Section.astro';
import PageHeader from '../../components/ui/PageHeader.astro';
import SubNav from '../../components/ui/SubNav.astro';
import PersonCard from '../../components/ui/PersonCard.astro';
import { getProfessors, getUI } from '../../lib/data';

const professors = getProfessors();
const ui = getUI();
---

<Layout title={ui.people.advisorsLabel} description={`${professors.length} ${ui.pages.advisorsDescription}`}>
  <Section>
    <PageHeader
      eyebrow={ui.people.sectionLabel}
      title={ui.people.advisorsLabel}
      description={`${professors.length} ${ui.pages.advisorsDescription}`}
    />

    <SubNav links={[
      { label: ui.people.studentsLabel, href: '/people/students' },
      { label: ui.people.ccpLabel, href: '/people/ccp' },
      { label: ui.people.alumniLabel, href: '/people/alumni' },
    ]} />

    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-4">
      {professors.map((p) => (
        <PersonCard professor={p} />
      ))}
    </div>
  </Section>
</Layout>
