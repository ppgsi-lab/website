---
import Layout from '../../layouts/Layout.astro';
import Section from '../../components/ui/Section.astro';
import PageHeader from '../../components/ui/PageHeader.astro';
import SubNav from '../../components/ui/SubNav.astro';
import SectionTitle from '../../components/ui/SectionTitle.astro';
import InfoBox from '../../components/ui/InfoBox.astro';
import { getStudents, getUI } from '../../lib/data';

const { doctorate, masters } = getStudents();
const ui = getUI();
---

<Layout title={ui.pages.studentsTitle} description={ui.pages.studentsDescription}>
  <Section>
    <PageHeader
      eyebrow={ui.people.sectionLabel}
      title={ui.pages.studentsTitle}
      description={ui.pages.studentsDescription}
    />

    <SubNav links={[
      { label: ui.people.advisorsLabel, href: '/people' },
      { label: ui.people.ccpLabel, href: '/people/ccp' },
      { label: ui.people.alumniLabel, href: '/people/alumni' },
    ]} />

    <!-- Doctoral students -->
    <SectionTitle class="text-display-section">{ui.pages.doctorateTitle}</SectionTitle>
    <p class="text-ink-3 text-sm mb-6">{doctorate.length} {ui.pages.doctorateCount}</p>

    <div class="overflow-x-auto mb-16">
      <table class="w-full text-left text-sm">
        <thead>
          <tr class="border-b-2 border-ink">
            <th class="py-3 pr-4 font-bold text-ink">{ui.table.name}</th>
            <th class="py-3 pr-4 font-bold text-ink">{ui.table.advisor}</th>
            <th class="py-3 pr-4 font-bold text-ink">{ui.table.entry}</th>
            <th class="py-3 pr-4 font-bold text-ink">{ui.table.lattes}</th>
            <th class="py-3 font-bold text-ink">{ui.table.email}</th>
          </tr>
        </thead>
        <tbody>
          {doctorate.map((s) => (
            <tr class="border-b border-rule">
              <td class="py-3 pr-4 text-ink font-medium">{s.name}</td>
              <td class="py-3 pr-4 text-ink-2">{s.advisor}</td>
              <td class="py-3 pr-4 text-ink-3">{s.entrySemester}</td>
              <td class="py-3 pr-4">
                {s.lattesUrl ? (
                  <a href={s.lattesUrl} target="_blank" rel="noopener" class="text-teal hover:underline">{ui.table.lattes}</a>
                ) : (
                  <span class="text-ink-4">--</span>
                )}
              </td>
              <td class="py-3 text-ink-3">{s.email}</td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>

    <!-- Master's students -->
    <SectionTitle class="text-display-section">{ui.pages.mastersTitle}</SectionTitle>
    <p class="text-ink-3 text-sm mb-6">{masters.length} {ui.pages.mastersCount}</p>

    <div class="overflow-x-auto mb-16">
      <table class="w-full text-left text-sm">
        <thead>
          <tr class="border-b-2 border-ink">
            <th class="py-3 pr-4 font-bold text-ink">{ui.table.name}</th>
            <th class="py-3 pr-4 font-bold text-ink">{ui.table.advisor}</th>
            <th class="py-3 pr-4 font-bold text-ink">{ui.table.entry}</th>
            <th class="py-3 pr-4 font-bold text-ink">{ui.table.lattes}</th>
            <th class="py-3 font-bold text-ink">{ui.table.email}</th>
          </tr>
        </thead>
        <tbody>
          {masters.map((s) => (
            <tr class="border-b border-rule">
              <td class="py-3 pr-4 text-ink font-medium">{s.name}</td>
              <td class="py-3 pr-4 text-ink-2">{s.advisor}</td>
              <td class="py-3 pr-4 text-ink-3">{s.entrySemester}</td>
              <td class="py-3 pr-4">
                {s.lattesUrl ? (
                  <a href={s.lattesUrl} target="_blank" rel="noopener" class="text-teal hover:underline">{ui.table.lattes}</a>
                ) : (
                  <span class="text-ink-4">--</span>
                )}
              </td>
              <td class="py-3 text-ink-3">{s.email}</td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>

    <InfoBox title={ui.pages.mailingLists}>
      Os alunos comunicam-se através de duas listas: uma oficial e moderada
      (<strong>alunosppgsi-each@listas.usp.br</strong>) para divulgação de mensagens
      de propósito geral, e outra informal (<strong>ppgsi-each@googlegroups.com</strong>)
      para trocas de mensagens entre os alunos.
    </InfoBox>
  </Section>
</Layout>
