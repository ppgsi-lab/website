---
import Layout from '../../../layouts/Layout.astro';
import PostCard from '../../../components/PostCard.astro';
import { getCollection } from 'astro:content';

export async function getStaticPaths() {
  function slugify(text: string): string {
    return text.toLowerCase().normalize('NFD').replace(/[\u0300-\u036f]/g, '').replace(/[^a-z0-9]+/g, '-').replace(/(^-|-$)/g, '');
  }

  const posts = await getCollection('posts');
  const authorsMap = new Map<string, { name: string; email: string; posts: typeof posts }>();

  for (const post of posts) {
    for (const author of post.data.authors) {
      const slug = slugify(author.name);
      if (!authorsMap.has(slug)) {
        authorsMap.set(slug, { name: author.name, email: author.email, posts: [] });
      }
      authorsMap.get(slug)!.posts.push(post);
    }
  }

  return [...authorsMap.entries()].map(([slug, data]) => ({
    params: { autor: slug },
    props: {
      authorName: data.name,
      authorEmail: data.email,
      posts: data.posts.sort((a, b) => b.data.date.getTime() - a.data.date.getTime()),
    },
  }));
}

const { authorName, authorEmail, posts } = Astro.props;
import { url } from '../../../lib/url';
---

<Layout title={`Posts de ${authorName}`} description={`Publicações de ${authorName} no PPgSI`}>
  <section class="mx-auto max-w-container px-8 py-section md:py-section-md">
    <a href={url("/posts")} class="text-sm text-ink-4 hover:text-ink transition-colors mb-8 inline-block">← Todos os posts</a>
    <p class="eyebrow text-teal mb-3">Autor</p>
    <h1 class="font-display text-display-page font-bold tracking-tight text-ink mb-2">
      {authorName}
    </h1>
    <p class="text-ink-4 mb-8">{authorEmail}</p>

    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-4">
      {posts.map((post) => (
        <PostCard
          title={post.data.title}
          authors={post.data.authors}
          date={post.data.date}
          tags={post.data.tags}
          summary={post.data.summary}
          slug={post.id}
          cover={post.data.cover}
        />
      ))}
    </div>
  </section>
</Layout>
