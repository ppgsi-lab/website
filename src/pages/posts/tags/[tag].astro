---
import Layout from '../../../layouts/Layout.astro';
import PostCard from '../../../components/PostCard.astro';
import { getCollection } from 'astro:content';

export async function getStaticPaths() {
  const posts = await getCollection('posts');
  const tags = [...new Set(posts.flatMap(p => p.data.tags))];
  return tags.map((tag) => ({
    params: { tag },
    props: {
      tag,
      posts: posts
        .filter(p => p.data.tags.includes(tag))
        .sort((a, b) => b.data.date.getTime() - a.data.date.getTime()),
    },
  }));
}

const { tag, posts } = Astro.props;
import { url } from '../../../lib/url';
---

<Layout title={`Posts sobre ${tag}`} description={`Publicações do PPgSI com a tag ${tag}`}>
  <section class="mx-auto max-w-container px-page py-section md:py-section-md">
    <a href={url("/posts")} class="text-sm text-ink-4 hover:text-ink transition-colors mb-8 inline-block">← Todos os posts</a>
    <p class="eyebrow text-teal mb-3">Tag</p>
    <h1 class="font-display text-display-page font-bold tracking-tight text-ink mb-8">
      {tag}
    </h1>

    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-4">
      {posts.map((post) => (
        <PostCard
          title={post.data.title}
          authors={post.data.authors}
          date={post.data.date}
          tags={post.data.tags}
          summary={post.data.summary}
          slug={post.id}
          cover={post.data.cover}
        />
      ))}
    </div>
  </section>
</Layout>
